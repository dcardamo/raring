<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:orientation="vertical"
 android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="8dp" android:background="@drawable/status_card">
 <include layout="@layout/status_notification_compact"/>
 <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical">
  <TextView android:layout_width="112dp" android:layout_height="wrap_content" android:text="Body Battery" android:textSize="11sp" android:textColor="#B2C2D3"/>
  <ProgressBar android:id="@+id/status_battery_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="5dp" android:progressTint="#EAF0F5"/>
 </LinearLayout>
 <LinearLayout android:layout_width="match_parent" android:layout_height="24dp" android:gravity="center_vertical">
  <TextView android:layout_width="112dp" android:layout_height="wrap_content" android:text="Stress" android:textSize="11sp" android:textColor="#B2C2D3"/>
  <ProgressBar android:id="@+id/status_stress_bar" style="?android:attr/progressBarStyleHorizontal" android:layout_width="0dp" android:layout_weight="1" android:layout_height="5dp" android:progressTint="#EAF0F5"/>
 </LinearLayout>
 <TextView android:id="@+id/status_focus" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="17sp" android:textColor="#FFFFFF"/>
 <TextView android:id="@+id/status_reason" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="2" android:ellipsize="end" android:textSize="11sp" android:textColor="#B2C2D3"/>
</LinearLayout>
