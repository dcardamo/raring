<?xml version="1.0" encoding="utf-8"?>
<!-- The decorated header carries "As of"; this layout adds no card of its own. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="vertical" android:paddingBottom="4dp">
    <TextView android:id="@+id/status_focus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:maxLines="2" android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification.Title"/>
    <TextView android:id="@+id/status_reason" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="2dp" android:maxLines="2" android:ellipsize="end"
        android:textAppearance="@style/TextAppearance.Compat.Notification"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="10dp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/status_battery" android:importantForAccessibility="no"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="Body Battery"
            android:textAppearance="@style/TextAppearance.Compat.Notification"/>
        <ProgressBar android:id="@+id/status_battery_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="6dp"
            android:max="100" android:progressDrawable="@drawable/status_meter"/>
        <TextView android:id="@+id/status_battery" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:minEms="2" android:gravity="end" android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/status_stress" android:importantForAccessibility="no"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="Stress"
            android:textAppearance="@style/TextAppearance.Compat.Notification"/>
        <ProgressBar android:id="@+id/status_stress_bar" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="6dp"
            android:max="100" android:progressDrawable="@drawable/status_meter"/>
        <TextView android:id="@+id/status_stress" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:minEms="2" android:gravity="end" android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"/>
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="28dp"
        android:orientation="horizontal" android:gravity="center_vertical">
        <ImageView android:layout_width="18dp" android:layout_height="18dp"
            android:src="@drawable/status_heart" android:importantForAccessibility="no"/>
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:layout_marginStart="10dp" android:text="Heart rate"
            android:textAppearance="@style/TextAppearance.Compat.Notification"/>
        <FrameLayout android:layout_width="0dp" android:layout_weight="1.2" android:layout_height="6dp"/>
        <TextView android:id="@+id/status_hr" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:minEms="2" android:gravity="end" android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Compat.Notification.Title"/>
    </LinearLayout>
</LinearLayout>
