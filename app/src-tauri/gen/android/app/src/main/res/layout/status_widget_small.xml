<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@android:id/background" android:orientation="vertical" android:gravity="center_horizontal"
 android:background="@drawable/status_card" android:padding="12dp"
 android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
  android:orientation="vertical" android:gravity="center">
  <FrameLayout android:id="@+id/status_tile_readiness" android:layout_width="72dp" android:layout_height="72dp">
   <ImageView android:id="@+id/status_gauge" android:layout_width="match_parent" android:layout_height="match_parent"
    android:importantForAccessibility="no"/>
   <TextView android:id="@+id/status_readiness" android:layout_width="match_parent" android:layout_height="match_parent"
    android:gravity="center" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_ink" android:textSize="24sp"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Readiness"
    android:layout_gravity="bottom|center_horizontal" android:includeFontPadding="false" android:textColor="@color/widget_text2" android:textSize="10sp"/>
  </FrameLayout>
  <TextView android:id="@+id/status_focus" android:layout_width="match_parent" android:layout_height="wrap_content"
   android:layout_marginTop="6dp" android:gravity="center" android:fontFamily="sans-serif-medium"
   android:textColor="@color/widget_ink" android:textSize="12sp"/>
 </LinearLayout>
 <TextView android:id="@+id/status_asof" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_marginTop="4dp" android:gravity="center" android:textColor="@color/widget_text3" android:textSize="10sp"/>
</LinearLayout>
