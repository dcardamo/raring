<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 android:id="@android:id/background" android:orientation="vertical" android:background="@drawable/status_card"
 android:padding="12dp" android:layout_width="match_parent" android:layout_height="match_parent">
 <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
  android:orientation="horizontal" android:gravity="center_vertical">
  <FrameLayout android:id="@+id/status_tile_readiness" android:layout_width="80dp" android:layout_height="80dp"
   android:layout_marginEnd="16dp">
   <ImageView android:id="@+id/status_gauge" android:layout_width="match_parent" android:layout_height="match_parent"
    android:importantForAccessibility="no"/>
   <TextView android:id="@+id/status_readiness" android:layout_width="match_parent" android:layout_height="match_parent"
     android:gravity="center" android:includeFontPadding="false" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_ink" android:textSize="26sp"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Readiness"
     android:layout_gravity="bottom|center_horizontal" android:includeFontPadding="false" android:textColor="@color/widget_text2" android:textSize="10sp"/>
  </FrameLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="match_parent"
   android:orientation="vertical">
  <LinearLayout android:id="@+id/status_tile_sleep" android:layout_width="match_parent" android:layout_height="0dp"
   android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
   <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Sleep"
    android:textColor="@color/widget_text2" android:textSize="12sp"/>
   <TextView android:id="@+id/status_sleep" android:layout_width="wrap_content" android:layout_height="wrap_content"
    android:layout_marginStart="8dp" android:fontFamily="sans-serif-medium" android:textColor="@color/widget_ink" android:textSize="18sp"/>
  </LinearLayout>
  <FrameLayout android:layout_width="match_parent" android:layout_height="1dp" android:background="@color/widget_line"/>
  <LinearLayout android:id="@+id/status_tile_hrv" android:layout_width="match_parent" android:layout_height="0dp"
   android:layout_weight="1" android:orientation="horizontal" android:gravity="center_vertical">
   <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="HRV"
    android:textColor="@color/widget_text2" android:textSize="12sp"/>
   <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp"
    android:orientation="vertical" android:gravity="end">
    <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="horizontal"
     android:baselineAligned="true">
     <TextView android:id="@+id/status_hrv" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:fontFamily="sans-serif-medium" android:textColor="@color/widget_ink" android:textSize="18sp"/>
     <TextView android:id="@+id/status_hrv_unit" android:layout_width="wrap_content" android:layout_height="wrap_content"
      android:layout_marginStart="3dp" android:text="ms" android:textColor="@color/widget_text3" android:textSize="11sp"
      android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/status_hrv_status" android:layout_width="wrap_content" android:layout_height="wrap_content"
     android:textSize="11sp" android:visibility="gone"/>
   </LinearLayout>
  </LinearLayout>
  </LinearLayout>
 </LinearLayout>
 <TextView android:id="@+id/status_asof" android:layout_width="match_parent" android:layout_height="wrap_content"
  android:layout_marginTop="4dp" android:textColor="@color/widget_text3" android:textSize="10sp"/>
</LinearLayout>
